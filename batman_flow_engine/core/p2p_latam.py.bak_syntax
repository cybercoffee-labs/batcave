import ccxt, requests
import numpy as np
import json, uuid
from pathlib import Path
from datetime import datetime

BASE_DIR = Path(__file__).resolve().parent.parent
LOG_FILE = BASE_DIR / "storage" / "logs" / "opportunities.jsonl"
def get_spot_price(pair="USDT/MXN"):
    try:
        b = ccxt.binance()
        ticker = b.fetch_ticker("USDT/MXN" if "USDT/MXN" in b.load_markets() else "BTC/USDT")
        return ticker["last"]
    except:
        return None

def get_p2p_price_binance(fiat="MXN", crypto="USDT", trade_type="BUY"):
    try:
        url = "https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search"
        payload = {
            "fiat": fiat,
            "page": 1,
            "rows": 10,
            "tradeType": trade_type,
            "asset": crypto,
            "countries": [],
            "proMerchantAds": False,
            "publisherType": None,
            "payTypes": [],
            "classifies": ["mass","profession"]
        }
        r = requests.post(url, json=payload, timeout=10)
        data = r.json().get("data", [])
        prices = [float(d["adv"]["price"]) for d in data if d.get("adv")]
def _append_to_log(opportunity):
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(opportunity) + "\n")
    except Exception as e:
        print(f"[p2p_latam] log error: {e}")

        return round(np.mean(prices[:5]), 4) if prices else None
    except:
        return None

def p2p_premium_analysis() -> dict:
    print("📡 Consultando precios P2P Binance LATAM...")

    p2p_buy  = get_p2p_price_binance("MXN", "USDT", "BUY")
    p2p_sell = get_p2p_price_binance("MXN", "USDT", "SELL")
    spot     = get_spot_price()

    result = {
        "ts": datetime.utcnow().isoformat(),
        "market": "MXN/USDT",
        "p2p_buy_price":  p2p_buy,
        "p2p_sell_price": p2p_sell,
        "spot_price":     spot,
        "status": "ok"
    }

    if p2p_buy and p2p_sell:
        merchant_spread = round((p2p_buy - p2p_sell) / p2p_sell, 5)
        result["merchant_spread"] = merchant_spread
        result["merchant_spread_pct"] = f"{merchant_spread*100:.3f}%"

    if p2p_buy and spot:
        premium = round((p2p_buy - spot) / spot, 5)
        if premium > 0.015:
            opp = {
                "opp_id": f"OPP-C-{uuid.uuid4().hex[:10].upper()}",
                "ts": datetime.utcnow().isoformat(),
                "type": "C",
                "asset": "USDT",
                "venue": "binance_p2p_latam",
                "spot_price": spot,
                "p2p_price": p2p_buy,
                "premium_pct": premium,
                "observe_only": True
            }
            _append_to_log(opp)

        result["p2p_premium"] = premium
        result["p2p_premium_pct"] = f"{premium*100:.3f}%"
        result["signal"] = (
            "🔴 STRESS — capital flight MXN"   if premium > 0.02  else
            "🟡 TENSION — presión compradora"   if premium > 0.005 else
            "🟢 NORMAL — mercado equilibrado"
        )

    return result

if __name__ == "__main__":
    r = p2p_premium_analysis()
    print(f"\n{'='*45}")
    print(f"🦇 BATMAN P2P LATAM MONITOR — {r['ts'][:16]}")
    print(f"{'='*45}")
    print(f"P2P BUY  (MXN/USDT): {r.get('p2p_buy_price')}")
    print(f"P2P SELL (MXN/USDT): {r.get('p2p_sell_price')}")
    print(f"SPOT     (MXN/USDT): {r.get('spot_price')}")
    print(f"Merchant Spread:     {r.get('merchant_spread_pct','N/A')}")
    print(f"P2P Premium vs Spot: {r.get('p2p_premium_pct','N/A')}")
    print(f"Signal:              {r.get('signal','N/A')}")
    print(f"{'='*45}")
