# Batman Lab — API Keys
# NEVER share this file. NEVER commit to git.
# Copy this to .env and fill in your keys:
#   cp .env.example .env

# Binance API (https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# === BYBIT SQUARE ===
BYBIT_SQUARE_API_KEY=your_bybit_square_key

# PostgreSQL (default works for local)
BATMAN_DB_HOST=localhost
BATMAN_DB_PORT=5432
BATMAN_DB_NAME=batman_lab
