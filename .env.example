# ============================================
# BATCAVE — Environment Configuration Example
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ============================================

# === BATMAN ENGINE ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# === NIGHTWING BRIDGE ===
# Override only if Batman is NOT in the default relative path
# Default: auto-detected relative to nightwing_agent/
BATMAN_BASE_PATH=/Volumes/Sonnet/Finance2026/batcave/batman_flow_engine

# === DATABASE ===
# SQLite is default and active. PostgreSQL is optional.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/batcave  # pragma: allowlist secret

# === TELEGRAM NOTIFICATIONS ===
# Get token from @BotFather on Telegram
# Get chat_id from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_CHAT_ID=123456789

# === GUARDIAN (Capital Protection) ===
GUARDIAN_DAILY_LOSS_LIMIT=50.0
GUARDIAN_MAX_POSITION_SIZE=0.8
GUARDIAN_TRADING_START_HOUR=9
GUARDIAN_TRADING_END_HOUR=21

# === CYBORG (Blockchain Security) ===
# Free API keys available at etherscan.io and bscscan.com
ETHERSCAN_API_KEY=your_etherscan_key_here
BSCSCAN_API_KEY=your_bscscan_key_here
POLYGONSCAN_API_KEY=your_polygonscan_key_here

# === EXCHANGES (Optional connectors) ===
BITSO_API_KEY=your_bitso_key_here
BITSO_API_SECRET=your_bitso_secret_here
BYBIT_API_KEY=your_bybit_key_here
BYBIT_API_SECRET=your_bybit_secret_here
